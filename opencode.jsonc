{
    "$schema": "https://opencode.ai/config.json",
    "permission": {
        // By default, all permissions are set to "ask".
        "*": "ask",

        // -------------------------------------------------------------------------
        // Allowed permissions.

        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "read": "allow",
        "todowrite": "allow",
        "websearch": "allow",

        // -------------------------------------------------------------------------
        // Allowed external directories.

        "external_directory": {
            "/tmp": "allow",
        },

        // -------------------------------------------------------------------------
        // Granular controls.

        "edit": {
            "*": "ask",
        },
        "bash": {
            "*": "ask",
            "ls *": "allow",
            "cat *": "allow",
            "git log *": "allow",
            "git ls-tree *": "allow",
            "git show *": "allow",
            "grep *": "allow",
            "head *": "allow",
            "sed *": "allow",
            "tail *": "allow",
            "tr *": "allow",
            "xargs *": "allow",
        },
    }
}
