{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    // By default, all permissions are set to "ask".
    "*": "ask",

    // -------------------------------------------------------------------------
    // Allowed permissions.

    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",

    // -------------------------------------------------------------------------
    // Granular controls.

    "edit": {
      "*": "ask",
    },
    "bash": {
      "*": "ask",
      "ls *": "allow",
      "cat *": "allow",
      "grep *": "allow",
      "sed *": "allow",
    },
  }
}
